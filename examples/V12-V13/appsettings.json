{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "_comment": "Optimizely V12/V13 Comprehensive Performance Counters Configuration",

  "ApplicationInsights": {
    "ConnectionString": "InstrumentationKey=YOUR-INSTRUMENTATION-KEY-HERE"
  },

  "Optimizely": {
    "PerformanceCounters": {
      "Enabled": true,
      "EventCounters": [
        {
          "_comment": "=== CPU & Process Metrics ===",
          "EventSourceName": "System.Runtime",
          "CounterName": "cpu-usage"
        },
        {
          "EventSourceName": "System.Runtime",
          "CounterName": "working-set"
        },

        {
          "_comment": "=== Memory & Garbage Collection ===",
          "EventSourceName": "System.Runtime",
          "CounterName": "gc-heap-size"
        },
        {
          "EventSourceName": "System.Runtime",
          "CounterName": "gen-0-gc-count"
        },
        {
          "EventSourceName": "System.Runtime",
          "CounterName": "gen-1-gc-count"
        },
        {
          "EventSourceName": "System.Runtime",
          "CounterName": "gen-2-gc-count"
        },
        {
          "EventSourceName": "System.Runtime",
          "CounterName": "time-in-gc"
        },
        {
          "EventSourceName": "System.Runtime",
          "CounterName": "gen-0-size"
        },
        {
          "EventSourceName": "System.Runtime",
          "CounterName": "gen-1-size"
        },
        {
          "EventSourceName": "System.Runtime",
          "CounterName": "gen-2-size"
        },
        {
          "EventSourceName": "System.Runtime",
          "CounterName": "loh-size"
        },
        {
          "EventSourceName": "System.Runtime",
          "CounterName": "poh-size"
        },
        {
          "EventSourceName": "System.Runtime",
          "CounterName": "alloc-rate"
        },
        {
          "EventSourceName": "System.Runtime",
          "CounterName": "gc-fragmentation"
        },

        {
          "_comment": "=== Threading & Concurrency ===",
          "EventSourceName": "System.Runtime",
          "CounterName": "threadpool-thread-count"
        },
        {
          "EventSourceName": "System.Runtime",
          "CounterName": "threadpool-queue-length"
        },
        {
          "EventSourceName": "System.Runtime",
          "CounterName": "threadpool-completed-items-count"
        },
        {
          "EventSourceName": "System.Runtime",
          "CounterName": "monitor-lock-contention-count"
        },
        {
          "EventSourceName": "System.Runtime",
          "CounterName": "active-timer-count"
        },

        {
          "_comment": "=== Application Health ===",
          "EventSourceName": "System.Runtime",
          "CounterName": "exception-count"
        },
        {
          "EventSourceName": "System.Runtime",
          "CounterName": "assembly-count"
        },

        {
          "_comment": "=== JIT Compilation ===",
          "EventSourceName": "System.Runtime",
          "CounterName": "il-bytes-jitted"
        },
        {
          "EventSourceName": "System.Runtime",
          "CounterName": "methods-jitted-count"
        },

        {
          "_comment": "=== ASP.NET Core Request Metrics ===",
          "EventSourceName": "Microsoft.AspNetCore.Hosting",
          "CounterName": "requests-per-second"
        },
        {
          "EventSourceName": "Microsoft.AspNetCore.Hosting",
          "CounterName": "total-requests"
        },
        {
          "EventSourceName": "Microsoft.AspNetCore.Hosting",
          "CounterName": "current-requests"
        },
        {
          "EventSourceName": "Microsoft.AspNetCore.Hosting",
          "CounterName": "failed-requests"
        },

        {
          "_comment": "=== Kestrel Web Server ===",
          "EventSourceName": "Microsoft.AspNetCore.Server.Kestrel",
          "CounterName": "connection-queue-length"
        },
        {
          "EventSourceName": "Microsoft.AspNetCore.Server.Kestrel",
          "CounterName": "request-queue-length"
        },
        {
          "EventSourceName": "Microsoft.AspNetCore.Server.Kestrel",
          "CounterName": "current-connections"
        },
        {
          "EventSourceName": "Microsoft.AspNetCore.Server.Kestrel",
          "CounterName": "total-connections"
        },
        {
          "EventSourceName": "Microsoft.AspNetCore.Server.Kestrel",
          "CounterName": "current-tls-handshakes"
        },

        {
          "_comment": "=== HTTP Client (Outbound Requests) ===",
          "EventSourceName": "System.Net.Http",
          "CounterName": "requests-started"
        },
        {
          "EventSourceName": "System.Net.Http",
          "CounterName": "requests-started-rate"
        },
        {
          "EventSourceName": "System.Net.Http",
          "CounterName": "requests-failed"
        },
        {
          "EventSourceName": "System.Net.Http",
          "CounterName": "current-requests"
        },
        {
          "EventSourceName": "System.Net.Http",
          "CounterName": "http11-connections-current-total"
        },
        {
          "EventSourceName": "System.Net.Http",
          "CounterName": "http20-connections-current-total"
        },
        {
          "EventSourceName": "System.Net.Http",
          "CounterName": "http30-connections-current-total"
        }
      ]
    }
  }
}
