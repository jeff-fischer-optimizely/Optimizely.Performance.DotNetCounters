<?xml version="1.0" encoding="utf-8"?>
<!--
  Optimizely Performance Counters Configuration

  This file contains all performance counter definitions for Optimizely V11.
  It is referenced from web.config using configSource.

  To disable counters: Set enabled="false"
  To customize: Add or remove <add> elements below
-->
<!--
  enableIISExpressPerformanceCounters: Application Insights refuses to collect
  Windows performance counters under IIS Express, so a developer running the site
  locally sees nothing. Set it to "true" for local development; leave it off in
  production, where the site runs under full IIS.
-->
<performanceCounters enabled="true" enableIISExpressPerformanceCounters="false">
  <counters>
    <!-- ASP.NET Request Metrics -->
    <add categoryName="\ASP.NET\Requests Queued"
         reportedName="ASP.NET Requests Queued" />
    <add categoryName="\ASP.NET\Requests Rejected"
         reportedName="ASP.NET Requests Rejected" />
    <add categoryName="\ASP.NET Applications(__Total__)\Requests/Sec"
         reportedName="ASP.NET Requests/Sec" />
    <add categoryName="\ASP.NET Applications(__Total__)\Request Wait Time"
         reportedName="ASP.NET Request Wait Time" />
    <add categoryName="\ASP.NET Applications(__Total__)\Request Execution Time"
         reportedName="ASP.NET Request Execution Time" />
    <add categoryName="\ASP.NET Applications(__Total__)\Requests Failed"
         reportedName="ASP.NET Requests Failed" />

    <!-- ASP.NET Cache Performance -->
    <add categoryName="\ASP.NET Applications(__Total__)\Cache Total Entries"
         reportedName="ASP.NET Cache Entries" />
    <add categoryName="\ASP.NET Applications(__Total__)\Cache Total Hits"
         reportedName="ASP.NET Cache Hits" />
    <add categoryName="\ASP.NET Applications(__Total__)\Cache Total Misses"
         reportedName="ASP.NET Cache Misses" />

    <!--
      Cache memory pressure. "Cache API" counts entries inserted through
      HttpRuntime.Cache, which is what EPiServer's HttpRuntimeCache uses, so these
      track the content cache itself; "Cache Total" adds ASP.NET's own output and
      compiled-page caches for the whole-process picture.

      A rising Trims count means ASP.NET is evicting entries to relieve memory
      pressure, and because EPiServer entries hang off master keys a trim can cascade
      well beyond the entries ASP.NET actually chose to drop. Read alongside
      "% Process Memory Limit Used", that turns an invisible failure mode into two
      lines on a chart.

      These six are in the built-in defaults but were missing from this file. Naming
      any counter here replaces the defaults outright rather than adding to them, so a
      site that adopted this template lost them - which is the opposite of what a
      "complete" configuration should do.
    -->
    <add categoryName="\ASP.NET Applications(__Total__)\Cache API Entries"
         reportedName="ASP.NET Cache API Entries" />
    <add categoryName="\ASP.NET Applications(__Total__)\Cache API Trims"
         reportedName="ASP.NET Cache API Trims" />
    <add categoryName="\ASP.NET Applications(__Total__)\Cache Total Trims"
         reportedName="ASP.NET Cache Total Trims" />
    <add categoryName="\ASP.NET Applications(__Total__)\Cache API Turnover Rate"
         reportedName="ASP.NET Cache API Turnover Rate" />
    <add categoryName="\ASP.NET Applications(__Total__)\Cache % Machine Memory Limit Used"
         reportedName="ASP.NET Cache % Machine Memory Limit Used" />
    <add categoryName="\ASP.NET Applications(__Total__)\Cache % Process Memory Limit Used"
         reportedName="ASP.NET Cache % Process Memory Limit Used" />

    <!-- CLR Memory Metrics -->
    <add categoryName="\.NET CLR Memory(_Global_)\# Bytes in all Heaps"
         reportedName="CLR Heap Size" />
    <add categoryName="\.NET CLR Memory(_Global_)\% Time in GC"
         reportedName="CLR % Time in GC" />
    <add categoryName="\.NET CLR Memory(_Global_)\# Gen 0 Collections"
         reportedName="CLR Gen 0 Collections" />
    <add categoryName="\.NET CLR Memory(_Global_)\# Gen 1 Collections"
         reportedName="CLR Gen 1 Collections" />
    <add categoryName="\.NET CLR Memory(_Global_)\# Gen 2 Collections"
         reportedName="CLR Gen 2 Collections" />
    <add categoryName="\.NET CLR Memory(_Global_)\Large Object Heap size"
         reportedName="CLR LOH Size" />
    <add categoryName="\.NET CLR Memory(_Global_)\Gen 0 heap size"
         reportedName="CLR Gen 0 Size" />
    <add categoryName="\.NET CLR Memory(_Global_)\Gen 1 heap size"
         reportedName="CLR Gen 1 Size" />
    <add categoryName="\.NET CLR Memory(_Global_)\Gen 2 heap size"
         reportedName="CLR Gen 2 Size" />

    <!-- CLR Threading & Locks -->
    <add categoryName="\.NET CLR LocksAndThreads(_Global_)\# of current logical Threads"
         reportedName="CLR Logical Threads" />
    <add categoryName="\.NET CLR LocksAndThreads(_Global_)\# of current physical Threads"
         reportedName="CLR Physical Threads" />
    <add categoryName="\.NET CLR LocksAndThreads(_Global_)\Contention Rate / sec"
         reportedName="CLR Contention Rate" />
    <add categoryName="\.NET CLR LocksAndThreads(_Global_)\Current Queue Length"
         reportedName="CLR Thread Queue Length" />
    <add categoryName="\.NET CLR LocksAndThreads(_Global_)\Total # of Contentions"
         reportedName="CLR Total Contentions" />

    <!-- Process Metrics -->
    <add categoryName="\Process(??APP_WIN32_PROC??)\% Processor Time"
         reportedName="Process CPU %" />
    <add categoryName="\Process(??APP_WIN32_PROC??)\Private Bytes"
         reportedName="Process Private Bytes" />
    <add categoryName="\Process(??APP_WIN32_PROC??)\Thread Count"
         reportedName="Process Thread Count" />
    <add categoryName="\Process(??APP_WIN32_PROC??)\Handle Count"
         reportedName="Process Handle Count" />

    <!-- Exception Tracking -->
    <add categoryName="\.NET CLR Exceptions(_Global_)\# of Exceps Thrown / sec"
         reportedName="CLR Exceptions/sec" />
  </counters>
</performanceCounters>
