<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Exercises the net472 appSettings binding for the thread pool probe. The values are
         deliberately unlike the defaults so a test asserting on them cannot pass by accident,
         and Enabled is left at true so the probe lifecycle tests behave as they do elsewhere. -->
    <add key="Optimizely:PerformanceCounters:ThreadPoolProbe:Enabled" value="true" />
    <add key="Optimizely:PerformanceCounters:ThreadPoolProbe:SampleIntervalSeconds" value="37" />
    <add key="Optimizely:PerformanceCounters:ThreadPoolProbe:SlowSampleThresholdMilliseconds" value="250" />

    <!-- Not a number. Binding has to fall back to the default rather than throw: a typo in a
         monitoring setting must not stop a site starting. -->
    <add key="Optimizely:PerformanceCounters:ThreadPoolProbe:LogsPerMinute" value="not-a-number" />
  </appSettings>
</configuration>
