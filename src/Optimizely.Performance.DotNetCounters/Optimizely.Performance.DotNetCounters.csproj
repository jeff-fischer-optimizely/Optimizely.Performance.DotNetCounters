<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      One target framework per runtime Optimizely supports, rather than the two ends of the
      range. A net6.0 asset does roll forward onto .NET 9, but it brings its .NET 6 era
      Microsoft.Extensions assemblies with it, and the site then has to unify them back up.
      Building each framework means every host resolves the assemblies that match its runtime.
    -->
    <TargetFrameworks>net472;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>Optimizely</Authors>
    <Company>Optimizely</Company>
    <Product>Optimizely Performance Counters</Product>
    <Description>Performance counters integration for Optimizely CMS V11, V12, and V13 supporting both .NET Framework and .NET Core+. Includes configuration templates for all scenarios.</Description>
    <PackageProjectUrl>https://github.com/optimizely</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);NU1603;NU1605</NoWarn>
    <!--
      Audit what this package chooses, not what Optimizely chooses. Every NU1902/NU1903 this
      restore produced - Newtonsoft.Json, ImageSharp, MailKit, MimeKit, Azure.Identity, the
      IdentityModel and SqlClient families - is transitive through EPiServer.CMS.Core and
      EPiServer.Framework. Not one of them is referenced or loaded by any code here.

      They appear because the EPiServer versions above are deliberately floors rather than
      current: 11.1.0, 12.10.0 and 13.0.0 are the oldest releases this package supports, and the
      oldest CMS naturally drags the oldest dependency graph with it. Raising them to silence the
      audit would raise the minimum Optimizely version a site needs in order to install this,
      which is the opposite of what those floors are for. Pinning the individual packages instead
      would put a version floor for ImageSharp and MailKit into our own .nuspec - this package has
      no business dictating either to a CMS site.

      A real site restores against its own CMS version and NuGet unification gives it that graph,
      not this one. 'direct' keeps the audit on the references this project actually declares,
      where a finding would be ours to fix.
    -->
    <NuGetAuditMode>direct</NuGetAuditMode>
    <Version>1.0.0</Version>
    <PackageVersion>1.0.0</PackageVersion>
    <PackageTags>optimizely;episerver;performance;counters;monitoring;application-insights;telemetry</PackageTags>
    <RepositoryUrl>https://github.com/optimizely/performance-counters</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeContentInPack>true</IncludeContentInPack>
    <ContentTargetFolders>content;contentFiles</ContentTargetFolders>
  </PropertyGroup>

  <!-- Include README and key documentation in package -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\QUICK_REFERENCE.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\docs\USAGE_GUIDE.md" Pack="true" PackagePath="docs\" />
  </ItemGroup>

  <!-- Content files - Configuration templates for .NET Framework (V11) -->
  <ItemGroup>
    <!-- Main config file - goes to project root -->
    <Content Include="..\..\examples\V11\Optimizely.PerformanceCounters.config">
      <Pack>true</Pack>
      <PackagePath>content\;contentFiles\any\any\</PackagePath>
      <BuildAction>None</BuildAction>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>

    <!-- Documentation/reference files - go to App_Data -->
    <Content Include="..\..\examples\V11\*.config" Exclude="..\..\examples\V11\Optimizely.PerformanceCounters.config">
      <Pack>true</Pack>
      <PackagePath>content\App_Data\Optimizely.PerformanceCounters\V11\;contentFiles\any\any\App_Data\Optimizely.PerformanceCounters\V11\</PackagePath>
      <BuildAction>None</BuildAction>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>

    <!-- XML snippet for web.config setup -->
    <Content Include="..\..\examples\V11\web.config.snippet.xml">
      <Pack>true</Pack>
      <PackagePath>content\App_Data\Optimizely.PerformanceCounters\V11\;contentFiles\any\any\App_Data\Optimizely.PerformanceCounters\V11\</PackagePath>
      <BuildAction>None</BuildAction>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Content files - Configuration templates for .NET 6+ (V12/V13) -->
  <ItemGroup>
    <Content Include="..\..\examples\V12-V13\*.json">
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\App_Data\Optimizely.PerformanceCounters\V12-V13\;content\App_Data\Optimizely.PerformanceCounters\V12-V13\</PackagePath>
      <BuildAction>None</BuildAction>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Include configuration guide and README -->
  <ItemGroup>
    <None Include="..\..\docs\CONFIGURATION_PRESETS_GUIDE.md">
      <Pack>true</Pack>
      <PackagePath>content\App_Data\Optimizely.PerformanceCounters\;contentFiles\any\any\App_Data\Optimizely.PerformanceCounters\</PackagePath>
    </None>
    <None Include="..\..\examples\README_AFTER_INSTALL.md">
      <Pack>true</Pack>
      <PackagePath>content\App_Data\Optimizely.PerformanceCounters\;contentFiles\any\any\App_Data\Optimizely.PerformanceCounters\</PackagePath>
    </None>
  </ItemGroup>

  <!-- Include build targets and install script -->
  <ItemGroup>
    <None Include="..\..\build\Optimizely.Performance.DotNetCounters.targets">
      <Pack>true</Pack>
      <PackagePath>build\</PackagePath>
    </None>
    <None Include="..\..\build\install.ps1">
      <Pack>true</Pack>
      <PackagePath>tools\</PackagePath>
    </None>
  </ItemGroup>

  <!-- .NET Framework 4.7.2 specific (V11) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <!-- Host-provided. PrivateAssets="all" + ExcludeAssets="runtime" so the CMS
         assemblies are used for compilation only and are never copied into (or
         upgraded in) the consuming site's bin. Pinned to the minimum supported
         version so the host's existing binding redirects can satisfy us. -->
    <PackageReference Include="EPiServer.CMS.Core" Version="11.1.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="EPiServer.Framework" Version="11.1.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.ApplicationInsights" Version="2.22.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.PerfCounterCollector" Version="2.22.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="6.0.0" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Web" />
  </ItemGroup>

  <!--
    Version floors for the .NET targets, one pair per framework.

    EPiServerVersion is the oldest CMS that runs on that framework: CMS 12 spans .NET 6
    through 9, CMS 13 is .NET 10 only. ExtensionsVersion matches the framework's major,
    because the Microsoft.Extensions packages version in lockstep with the runtime and
    asking for 6.0.0 on a .NET 9 host would put a down-level assembly in its graph for no
    reason. Both are floors and not pins - a site on a newer CMS or a newer Extensions
    keeps its own through NuGet unification.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <EPiServerVersion>12.10.0</EPiServerVersion>
    <ExtensionsVersion>6.0.0</ExtensionsVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net7.0'">
    <EPiServerVersion>12.10.0</EPiServerVersion>
    <ExtensionsVersion>7.0.0</ExtensionsVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <EPiServerVersion>12.10.0</EPiServerVersion>
    <ExtensionsVersion>8.0.0</ExtensionsVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <EPiServerVersion>12.10.0</EPiServerVersion>
    <ExtensionsVersion>9.0.0</ExtensionsVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <EPiServerVersion>13.0.0</EPiServerVersion>
    <ExtensionsVersion>10.0.0</ExtensionsVersion>
  </PropertyGroup>

  <!-- .NET 6+ packages (V12 and V13) -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net472'">
    <!-- Ordinary references, deliberately NOT PrivateAssets="all": CMS 12's type
         scanner only loads assemblies whose dependency graph contains an EPiServer
         package, so hiding these from the nuspec makes our [InitializableModule]
         invisible and the library silently does nothing. -->
    <PackageReference Include="EPiServer.CMS.Core" Version="$(EPiServerVersion)" />
    <PackageReference Include="EPiServer.Framework" Version="$(EPiServerVersion)" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="$(ExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(ExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(ExtensionsVersion)" />
  </ItemGroup>

</Project>
